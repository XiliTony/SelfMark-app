            "type": "string",
            "maxLength": 50,
            "example": "画板"
          },
          "description": {
            "type": "string",
            "maxLength": 500,
            "nullable": true,
            "example": null
          },
          "sort": {
            "type": "integer",
            "description": "升序排列，同值按目录ID升序。",
            "example": 1
          },
          "installed": {
            "type": "boolean",
            "description": "禁用实例仍视为已安装。",
            "example": false
          },
          "userPluginId": {
            "type": "integer",
            "format": "int64",
            "description": "当前用户的实例ID，未安装时显式null。",
            "nullable": true,
            "example": null
          },
          "enabled": {
            "type": "boolean",
            "description": "已安装时为布尔值，未安装时显式null。",
            "nullable": true,
            "example": null
          },
          "config": {
            "type": "object",
            "additionalProperties": true,
            "description": "当前用户的完整配置对象，未安装时显式null；不是JSON字符串。数值采用MySQL JSON原生精度，高精度值需作为对象中的字符串保存。",
            "properties": {},
            "nullable": true,
            "example": null
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "mobile",
          "password"
        ],
        "properties": {
          "mobile": {
            "type": "string",
            "pattern": "^1[3-9]\\d{9}$",
            "example": "13800138000"
          },
          "password": {
            "type": "string",
            "format": "password",
            "description": "最多 72 个 UTF-8 字节（bcrypt 限制）"
