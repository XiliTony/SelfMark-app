            "type": "string",
            "pattern": "^1[3-9]\\d{9}$",
            "example": "13800138000"
          },
          "password": {
            "type": "string",
            "format": "password",
            "description": "最多 72 个 UTF-8 字节（bcrypt 限制）"
          },
          "username": {
